	(title_block
		(title "ADSB_Test - Top level")
		(date "2026-10-09")
		(rev "A")
		(comment 1 "ESP32-P4 ADS-B test board, derived from Waveshare ESP32-P4-WIFI6-Touch-LCD-7B-C")
	)
	(lib_symbols)
	(text_box "ADSB_Test Rev A - hierarchy overview\nESP32-P4 + ESP32-C6, Ethernet, User USB-C (PD sink + user UART), Dev USB-C (hub: P4/C6 USB-JTAG, FT4232H UARTs + M1421 JTAG),\nUSB-A host for up to 4 SDRs, GPS, 2S battery + charger, V/I monitoring on every rail, 7in MIPI-DSI display + touch, M1421 pads.\nDocs: boards/adsb-test/docs (requirements, architecture, open questions, test plan)."
		(exclude_from_sim no)
