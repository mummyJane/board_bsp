	(title_block
		(title "ADSB_Test - Top level")
		(date "2026-10-09")
		(rev "A")
		(comment 1 "ESP32-P4 ADS-B test board, derived from Waveshare ESP32-P4-WIFI6-Touch-LCD-7B-C")
	)
	(lib_symbols)
	(text_box "ADSB_Test Rev A - hierarchy overview\nOSPTEK ESP32-P4C5 module (P4 + C5 Wi-Fi 6 over SDIO, RP-SMA Wi-Fi antenna), Ethernet (LAN8720A), User USB-C (PD sink + user UART), Dev USB-C (hub:\nP4 USB-Serial/JTAG, FT2232H P4 + C5 consoles, RP2040 ADSBee Programmer for the m1421), ADSBee m1421 (1090 + 978 MHz),\nUSB-A host (external hub, SDRs), GPS, 2S Li-ion + BQ25798 charger, V/I monitoring on every rail, 7in display + touch,\nmicroSD, LA5016 header. Sheets are generated by boards/adsb-test/hardware/gen; docs in boards/adsb-test/docs."
		(exclude_from_sim no)
