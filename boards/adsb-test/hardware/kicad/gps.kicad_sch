	(text "GNSS: u-blox MAX-M10S, UART2 to the P4 (38400 baud default), PPS -> P4 GPIO4 + LED + LA CH2.\nV_BCKP from VBACKUP (always on) for hot starts; RESET_N from the expander (bit 6, released = input).\nActive antenna fed from VCC_RF through 10R + 47 nH; RF_IN is DC-blocked inside. 50R CPW to the edge SMA.\nSH1201: optional RF can over the module + bias parts (fit after soldering/testing; RF trace leaves on an inner layer)."
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3db4de65-95e6-415a-a5e9-44c2acbea3d9")
	)
