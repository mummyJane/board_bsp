	(text "USB HOST: P4 HS OTG (module pads 44/45) -> USBLC6 -> USB-A, 90R differential, short.\nVBUS: 5V_SDR (shunt RS402, PM1 CH4) -> TPS259621 eFuse (~1.5 A, 5.7 V clamp, dV/dt 10 nF) -> 150 uF.\nEN from the expander (EXP_USBA_EN, 100k pull-down: off at reset), FAULT (open drain) -> P4 GPIO27.\nPowerPAD: thermal vias let it be soldered from the back. External powered hub for 2+ SDRs."
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
