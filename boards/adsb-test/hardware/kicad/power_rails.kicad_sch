	(text "POWER: SW401 OFF = PWR_EN low = both bucks off.\nVSYS, charger and VBACKUP stay alive."
		(exclude_from_sim no)
		(at 25.4 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4052ca75-bf95-4d7e-b552-3df05e653eb9")
	)
	(text "RAILS: two TPS62933 bucks from VSYS (5 V and 3V3, 3 A each),\nshared PWR_EN with UVLO ~5.5 V. Every branch has a Kelvin shunt\n(PAC1954 channel on its sense labels) that doubles as a bring-up link.\nTPS22917 load switches on 5V_LCD, 3V3_ETH, 3V3_GPS, 3V3_M1421\n(enabled from the TCA6408A). 3V3_MCU feeds the OSPTEK P4+C5 module."
		(exclude_from_sim no)
		(at 25.4 266.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9aa4826e-67a2-4f6d-ac7e-5c2ead177862")
	)
