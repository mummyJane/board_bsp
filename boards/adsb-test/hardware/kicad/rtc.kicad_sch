	(text "RTC: DS3231M (+/-5 ppm, MEMS resonator, no crystal) at I2C 0x68.\nVCC from 3V3 when on; VBAT from VBACKUP (always-on 3.0 V LDO, optional CR1220) when off.\nINT/SQW (open drain) -> P4 GPIO6 (LP GPIO: alarm wake-up from deep sleep).\nReplaces the P4's own RTC backup: the WT01P4C5-S1 has no VBAT pin (Q27)."
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
