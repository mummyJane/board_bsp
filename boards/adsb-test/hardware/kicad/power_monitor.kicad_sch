	(text "PM1: CH1 VBUS_USER, CH2 VBAT (bidirectional), CH3 VSYS, CH4 5V_SDR\nPM2: CH1 5V_LCD, CH2 3V3_P4, CH3 3V3_C5, CH4 3V3_ETH\nPM3: CH1 3V3_GPS, CH2 3V3_M1421, CH3 3V3_PERIPH, CH4 3V3 total\nSense lines: Kelvin from each shunt (pins 2/3), routed as pairs."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0e06529f-bbe7-4843-9edf-5d309d7e6f4d")
	)
	(text_box "DESIGN NOTES - POWER MONITOR\n\n3 x PAC1954 (4-ch V+I, energy accumulators) on shared I2C, ALERT wired-OR to P4.\nPM1: VBUS_USER, VBAT, VSYS, 5V_SDR\nPM2: 5V_LCD, 3V3_P4, 3V3_C5, 3V3_ETH\nPM3: 3V3_GPS, 3V3_M1421, 3V3_PERIPH, 5V total\nKelvin sense from each shunt + Kelvin test pads. I2C addresses set by ADDRSEL resistor (TBC)."
		(exclude_from_sim no)
		(at 322.58 17.78 0)
		(size 88.9 248.92)
		(margins 1.5 1.5 1.5 1.5)
