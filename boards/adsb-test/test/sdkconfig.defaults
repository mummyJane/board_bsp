# ADSB_Test: Wireless-Tag WT01P4C5-S1 module (ESP32-P4 + ESP32-C5, 16 MB flash, 32 MB PSRAM)
CONFIG_IDF_TARGET="esp32p4"
# The module is rated 360 MHz, i.e. P4 silicon below v3 (as the rev v1.3 reference unit), so
# the default build targets v0.x/v1.x. Read the module's revision with `esptool chip_id`;
# for rev v3.x silicon build with
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.rev3" ...
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# 16 MB on the module (also fine on the reference unit's 32 MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FATFS_LFN_HEAP=y
