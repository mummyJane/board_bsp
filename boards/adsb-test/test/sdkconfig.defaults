# ADSB_Test: OSPTEK ESP32-P4C5 Core module (ESP32-P4 rev v3.x + ESP32-C5, 16 MB flash, 32 MB PSRAM)
CONFIG_IDF_TARGET="esp32p4"
# The module uses P4 silicon rev v3.x (OSPTEK README). To run this app on the rev v1.3
# Waveshare reference unit build with
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.rev1" ...
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
# 16 MB on the module (also fine on the reference unit's 32 MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FATFS_LFN_HEAP=y
